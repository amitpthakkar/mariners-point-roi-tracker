rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'amitpthakkar@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /trackers/amit {
      allow get: if isOwner();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stateJson', 'revision', 'updatedAt'])
        && request.resource.data.stateJson is string
        && request.resource.data.stateJson.size() < 850000
        && request.resource.data.revision is int
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt is string;
    }
  }
}
